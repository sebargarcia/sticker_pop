{
	"expo": {
		"name": "StickerPop",
		"slug": "sticker_pop",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "sticker_pop",
		"userInterfaceStyle": "automatic",
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "com.anonymous.sticker-pop"
		},
		"android": {
			"adaptiveIcon": {
				"backgroundColor": "#E6F4FE",
				"foregroundImage": "./assets/images/android-icon-foreground.png",
				"backgroundImage": "./assets/images/android-icon-background.png",
				"monochromeImage": "./assets/images/android-icon-monochrome.png"
			},
			"predictiveBackGestureEnabled": false,
			"package": "com.anonymous.sticker_pop"
		},
		"web": {
			"bundler": "metro",
			"output": "static",
			"favicon": "./assets/images/favicon.png"
		},
		"plugins": [
			"expo-router",
			"expo-font",
			[
				"expo-image-picker",
				{
					"photosPermission": "Allow StickerPop to access your photos to turn them into stickers.",
					"cameraPermission": "Allow StickerPop to use your camera to take photos for stickers."
				}
			],
			[
				"expo-media-library",
				{
					"photosPermission": "Allow StickerPop to save stickers to your photos.",
					"savePhotosPermission": "Allow StickerPop to save stickers to your photos.",
					"isAccessMediaLocationEnabled": true
				}
			],
			[
				"expo-splash-screen",
				{
					"image": "./assets/images/splash-icon.png",
					"imageWidth": 200,
					"resizeMode": "contain",
					"backgroundColor": "#ffffff",
					"dark": {
						"backgroundColor": "#000000"
					}
				}
			]
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		}
	}
}
