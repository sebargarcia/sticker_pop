# Copy to .env and fill in (never commit .env).
# Server URL has a platform-aware default (10.0.2.2 on Android emulator,
# localhost elsewhere) — only set this for physical devices (LAN IP) or
# a deployed backend.
EXPO_PUBLIC_SERVER_URL=http://10.0.2.2:3000

# Required for sticker generation. Get one at https://aistudio.google.com.
EXPO_PUBLIC_GEMINI_API_KEY=

# Image model (stable default; override only if Google retires it again).
EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-flash-image
